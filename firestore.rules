rules_version = '2';

// Afsona Restaurant — Firestore xavfsizlik qoidalari
//
// Asosiy tamoyil: mijoz brauzeri hech qachon pul bilan bog'liq
// ma'lumotni yoza olmaydi. Buyurtma, promokod va statuslar faqat
// server tomonidan (Vercel serverless funksiyalari yoki bot'ning
// service account'i orqali) yoziladi.
//
// Admin SDK (/api/*) bu qoidalarni butunlay chetlab o'tadi — shuning uchun
// server uchun alohida ruxsat yozish shart emas.
//
// /admin paneli esa oddiy brauzer mijozi: u Firebase Auth (email+parol)
// bilan kiradi va `admin: true` custom claim oladi. Claim'ni faqat server
// (/api/admin, action=session) qo'yadi — ya'ni pastdagi isAdmin() tekshiruvi
// ishonchli.
//
// Deploy:  firebase deploy --only firestore:rules
// yoki Firebase Console → Firestore → Rules ga nusxalang.

service cloud.firestore {
  match /databases/{database}/documents {

    // Foydalanuvchi Telegram id'si bilan tizimga kirgan bo'lishi kerak.
    // uid — Telegram user id'sining matn ko'rinishi (/api/auth beradi).
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == string(userId);
    }

    // Boshqaruv paneli. Claim'ni server beradi, mijoz o'zi qo'ya olmaydi.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // ── Katalog: hamma o'qiydi, hech kim yozmaydi ────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Profil: faqat o'zinikini ────────────────────────────
    // Foydalanuvchi ismi, telefoni va manzillarini o'zgartira oladi.
    // Boshqa maydonlarni (masalan rollarni) o'zgartira olmaydi.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;  // /api/auth yaratadi
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['first_name', 'last_name', 'phone', 'addresses', 'language']);
      allow delete: if false;

      // Mijoz qaysi taomlarni sotib olgani — sharh qoldirish huquqi shu
      // bo'yicha tekshiriladi. Yozuvni faqat server qo'yadi (buyurtma
      // «Yetkazildi» bo'lganda), mijoz esa o'zinikini ko'ra oladi.
      match /purchased/{productId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ── Buyurtmalar: o'qish mumkin, yozish YO'Q ─────────────
    // Buyurtmani faqat /api/orders yaratadi (narx serverda hisoblanadi),
    // statusni faqat bot o'zgartiradi.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == int(request.auth.uid));
      // Panel statusni /api/admin orqali o'zgartiradi (mijozga xabar ham
      // o'sha yerda ketadi). Bu yerda faqat kichik tuzatishlarga ruxsat.
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // ── Sharhlar ────────────────────────────────────────────
    // Hamma o'qiydi. Yozishda: faqat o'z nomidan, 1-5 oralig'ida baho.
    // Sharhni /api/reviews yaratadi: u sotib olganini tekshiradi va
    // mahsulotdagi reytingni qayta hisoblaydi. Mijoz to'g'ridan-to'g'ri
    // yoza olmaydi (F-09, 9- va 10-bandlar).
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Bildirishnomalar ────────────────────────────────────
    // Faqat o'zinikini o'qiydi va faqat "read" bayrog'ini o'zgartira oladi.
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == int(request.auth.uid));
      allow create, delete: if isAdmin();
      allow update: if signedIn()
                    && resource.data.userId == int(request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ── Promokodlar: mijoz ko'ra olmaydi ────────────────────
    // Tekshirish /api/promo va /api/orders orqali.
    match /promocodes/{promoId} {
      allow read, write: if isAdmin();

      // Kim qachon foydalangani — har foydalanish alohida hujjat.
      // Ilgari bu ota hujjatdagi `usedBy` massivida edi va cheksiz
      // o'sardi. Yozishni faqat server (Admin SDK) bajaradi, panelga
      // esa o'qish kerak bo'lishi mumkin.
      match /uses/{userId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ── Sozlamalar ──────────────────────────────────────────
    //
    // Ruxsat HUJJAT BO'YICHA ajratilgan. Ilgari shart `signedIn()` edi —
    // ya'ni ilovaga kirgan istalgan mijoz `admins` (panel email'lari) va
    // `couriers` (xodimlarning telefon raqamlari, guruh id'si) hujjatlarini
    // o'qiy olardi.
    //
    //   hours, brand        — ilova ochilishi bilan, kirmasdan ham kerak
    //                         ("yopiq" holati, restoran nomi va aloqasi)
    //   payment, delivery   — buyurtma berish uchun kerak (karta raqami,
    //                         yetkazish narxi), faqat kirgan mijozga
    //   admins, couriers,   — faqat panel
    //   channel
    match /settings/{docId} {
      allow read: if docId in ['hours', 'brand']
                  || (signedIn() && docId in ['payment', 'delivery'])
                  || isAdmin();
      allow write: if isAdmin();
    }

    // ── Kanal postlari tarixi: faqat panel ──────────────────
    //
    // Postni /api/admin yaratadi (Admin SDK qoidalarni chetlab o'tadi).
    // Panelga esa o'qish kerak: «Tarix» ro'yxati va undagi «Aksiya
    // tugadi» / «O'chirish» tugmalari shu ma'lumotdan ishlaydi.
    //
    // Bu qoida ilgari umuman yozilmagan edi — kolleksiya oxirgi
    // `allow read, write: if false` ga tushib qolar, natijada Kanal
    // sahifasidagi tarix hech qachon yuklanmasdi (jimgina bo'sh turardi).
    match /channelPosts/{postId} {
      allow read, write: if isAdmin();
    }

    // ── Hisoblagichlar: faqat server ────────────────────────
    match /counters/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Analitika: panel o'qiydi, /api/track yozadi ─────────
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Yuqorida sanalmagan hamma narsa yopiq
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
