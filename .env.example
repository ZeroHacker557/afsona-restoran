# ══════════════════════════════════════════════════════════════
#  Afsona Restaurant — muhit o'zgaruvchilari
#
#  Bu fayl NAMUNA. Haqiqiy qiymatlar hech qachon git'ga tushmaydi:
#    • Vercel uchun  → Settings → Environment Variables
#    • Bot uchun     → loyiha ildizida `.env` fayli (bu fayldan nusxa)
# ══════════════════════════════════════════════════════════════

# ─── Telegram ────────────────────────────────────────────────
# @BotFather bergan token. Mini app imzosi ham shu bilan tekshiriladi —
# sizib chiqsa, istalgan odam istalgan foydalanuvchi nomidan kira oladi.
BOT_TOKEN=

# Bot foydalanuvchi nomi, @ belgisisiz (masalan: afsona_bot)
BOT_USERNAME=

# Mini app manzili (Vercel domeni)
MINI_APP_URL=https://afsona.vercel.app

# Admin panel manzili — buyurtma xabarnomasidagi tugma shu yerga olib boradi
ADMIN_PANEL_URL=https://afsona.vercel.app/admin


# ─── Firebase ────────────────────────────────────────────────
# Service account JSON — BUTUNLIGICHA, bitta qatorda (Vercel uchun).
# Firebase Console → Project Settings → Service accounts →
# "Generate new private key".
FIREBASE_SERVICE_ACCOUNT=

# Bot uchun o'sha kalitning fayl yo'li (loyiha ildiziga nisbatan).
# Bo'sh qoldirilsa, ildizdagi *firebase-adminsdk*.json fayli topiladi.
FIREBASE_KEY_FILE=

# Storage bucket nomi. Bo'sh qoldirilsa <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=


# ─── Admin panel (/admin) ────────────────────────────────────
# Egalar ro'yxati: shu emaillar doim admin bo'lib qoladi va ularni
# paneldan o'chirib bo'lmaydi. Vergul bilan ajratiladi.
ADMIN_EMAILS=admin@afsona.uz

# Birinchi admin hisobini yaratish (va parolni tiklash) uchun maxfiy kalit.
# Uzun va tasodifiy bo'lsin. /admin sahifasidagi "Birinchi sozlash" da kerak.
ADMIN_SETUP_KEY=

# Yangi buyurtma xabari keladigan Telegram ID'lar (vergul bilan).
# Panel ichidan ham qo'shish mumkin — bu zaxira ro'yxat.
ADMIN_CHAT_IDS=
