# ─── Vercel Environment Variables ────────────────────────────
# Bu qiymatlar Vercel loyihasining Settings → Environment Variables
# bo'limiga qo'shiladi (Production, Preview va Development uchun).
# Bu fayl namuna — haqiqiy qiymatlar hech qachon git'ga tushmaydi.

# Telegram bot tokeni. initData imzosi shu bilan tekshiriladi —
# ya'ni bu token butun autentifikatsiyaning kalitidir. Sizib chiqsa,
# istalgan odam istalgan foydalanuvchi nomidan kira oladi.
BOT_TOKEN=

# Firebase service account JSON — BUTUNLIGICHA, bitta qatorda.
# Firebase Console → Project Settings → Service accounts →
# "Generate new private key" tugmasi bilan olinadi.
# Faylni ochib, ichidagi JSON'ni to'liq nusxalang.
FIREBASE_SERVICE_ACCOUNT=


# ─── Bot uchun (bot/config.py) ───────────────────────────────
# Bot hozircha config.py dan o'qiydi. Uni ham env'ga o'tkazish
# tavsiya etiladi, lekin bu alohida ish.
